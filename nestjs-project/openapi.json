              }
            }
          }
        },
        "summary": "Get the public data of a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/stream": {
      "get": {
        "description": "Redirects to a short-lived signed URL of the object storage. The storage serves the bytes and answers Range requests with 206 Partial Content, so playback starts without downloading the whole file. Only for videos that are ready.",
        "operationId": "VideosController_stream",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the signed URL (Location header)"
          },
          "404": {
            "description": "Video not found or not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Stream a video",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/download": {
      "get": {
        "description": "Redirects to a short-lived signed URL that makes the browser save the file under its original name. Only for videos that are ready.",
        "operationId": "VideosController_download",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the signed URL (Location header)"
          },
          "404": {
            "description": "Video not found or not ready",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Download the original video file",
        "tags": [
          "videos"
        ]
      }
    },
    "/videos/{publicId}/thumbnail": {
      "get": {
        "description": "Redirects to a short-lived signed URL of the JPEG thumbnail generated from a frame of the video. Only for videos that are ready.",
        "operationId": "VideosController_thumbnail",
        "parameters": [
          {
            "name": "publicId",
            "required": true,
            "in": "path",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "302": {
            "description": "Redirect to the signed URL (Location header)"
          },
          "404": {
            "description": "Video not found, not ready or without thumbnail",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiErrorEnvelope"
                }
              }
            }
          }
        },
        "summary": "Get the thumbnail of a video",
        "tags": [
          "videos"
        ]
      }
    }
  },
