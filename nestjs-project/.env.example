# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=streamtube
DB_PASSWORD=streamtube
DB_NAME=streamtube

# JWT
JWT_SECRET=change-me-in-production
JWT_REFRESH_SECRET=change-me-refresh-in-production
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d
CONFIRMATION_TOKEN_EXPIRATION_HOURS=1
PASSWORD_RESET_TOKEN_EXPIRATION_HOURS=1

# Mail (Mailpit for local development)
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM="StreamTube" <noreply@streamtube.com>

# Object storage (S3-compatible). S3_ENDPOINT is the Compose service name (server-to-server);
# S3_PUBLIC_ENDPOINT is the address the browser sees, used only to sign URLs.
S3_ENDPOINT=http://storage:8333
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_ACCESS_KEY=streamtube
S3_SECRET_KEY=streamtube-secret
S3_BUCKET=streamtube-videos
S3_FORCE_PATH_STYLE=true
S3_CORS_ALLOWED_ORIGINS=*

# Queue (Redis)
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_PREFIX=bull

# Videos
VIDEO_MAX_SIZE_BYTES=10737418240
VIDEO_PART_SIZE_BYTES=67108864
VIDEO_ALLOWED_CONTENT_TYPES=video/mp4,video/webm,video/quicktime,video/x-matroska
VIDEO_UPLOAD_URL_TTL_SECONDS=900
VIDEO_URL_TTL_SECONDS=3600
VIDEO_JOB_ATTEMPTS=3
VIDEO_JOB_BACKOFF_MS=5000
VIDEO_RECONCILE_INTERVAL_SECONDS=300
VIDEO_PROCESSING_STALE_SECONDS=3600
VIDEO_UPLOAD_TTL_HOURS=24
